# Flask Application Secret Key
SECRET_KEY=generate_with_python_secrets_token_hex_32

# Database Connection URI
# Development (SQLite): sqlite:///instance/attendance.db
# Production (PostgreSQL): postgresql://user:password@db:5432/attendance_db
DATABASE_URL=sqlite:///instance/attendance.db

# Biometric Fernet Encryption Key (Required to encrypt 512-D ArcFace vectors)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_fernet_key_here

# Google Sheets API Integration
# Path to service account JSON credentials or inline JSON string
GOOGLE_SERVICE_ACCOUNT_JSON=instance/service_account.json

# Google Spreadsheet ID (from spreadsheet URL: /d/<ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

